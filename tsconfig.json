{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "typeRoots": ["./source/types", "./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["source/**/*.ts"],
  "exclude": ["node_modules", "build"]
}
