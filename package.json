{
  "name": "markdown-htmd-exports",
  "displayName": "Markdown HTMD Exports",
  "description": "Exports Markdown files (.md) to self-contained Markdown HTMD files (.htmd) which open automatically in VS Code's built-in viewer and your default web browser.",
  "version": "1.0.1",
  "publisher": "tbruneel",
  "license": "MIT",
  "homepage": "https://github.com/tbruneel/vscode-extension-markdown-htmd-exports#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/tbruneel/vscode-extension-markdown-htmd-exports.git"
  },
  "bugs": {
    "url": "https://github.com/tbruneel/vscode-extension-markdown-htmd-exports/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "assets/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "html",
    "export",
    "htmd",
    "katex",
    "mermaid"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:extension.markdown-htmd-exports.export",
    "onCommand:extension.markdown-htmd-exports.showSource",
    "onCustomEditor:markdown-htmd-exports.viewer",
    "onLanguage:markdown"
  ],
  "main": "./build/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "html",
        "extensions": [
          ".htmd"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "markdown-htmd-exports.viewer",
        "displayName": "Markdown HTMD Exports Viewer",
        "selector": [
          {
            "filenamePattern": "*.htmd"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "extension.markdown-htmd-exports.export",
        "title": {
          "value": "Markdown HTMD Exports: Export",
          "original": "Open Preview to the Side~export"
        },
        "icon": "$(export)",
        "group": "markdown-htmd-exports"
      },
      {
        "command": "extension.markdown-htmd-exports.showSource",
        "title": "Open Source File",
        "icon": "$(file-code)",
        "group": "markdown-htmd-exports"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "when": "resourceLangId == markdown",
          "command": "extension.markdown-htmd-exports.export"
        },
        {
          "when": "activeCustomEditorId == 'markdown-htmd-exports.viewer'",
          "command": "extension.markdown-htmd-exports.showSource"
        }
      ],
      "editor/title": [
        {
          "when": "editorLangId == markdown",
          "command": "extension.markdown-htmd-exports.export",
          "group": "navigation@1"
        },
        {
          "when": "activeCustomEditorId == 'markdown-htmd-exports.viewer'",
          "command": "extension.markdown-htmd-exports.showSource",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId == markdown",
          "command": "extension.markdown-htmd-exports.export",
          "group": "markdown-htmd-exports@1"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .md",
          "command": "extension.markdown-htmd-exports.export",
          "group": "markdown-htmd-exports@1"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Markdown HTMD Exports",
      "properties": {
        "markdown-htmd-exports.convertOnSave": {
          "type": "string",
          "enum": [
            "ifExists",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Automatically update <file>.htmd on save only if <file>.htmd already exists next to the Markdown file.",
            "Always create or update <file>.htmd whenever a Markdown file is saved.",
            "Only export manually via the 'Markdown HTMD Exports: Export' command."
          ],
          "default": "ifExists",
          "description": "Control automatic .htmd export when saving a Markdown (.md) file."
        },
        "markdown-htmd-exports.convertOnSaveExclude": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Regex patterns for filenames excluded from convertOnSave."
        },
        "markdown-htmd-exports.styles": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Local paths or URLs to CSS stylesheets to inline into the exported .htmd file."
        },
        "markdown-htmd-exports.stylesRelativePathFile": {
          "type": "boolean",
          "default": false,
          "description": "Interpret relative paths in markdown-htmd-exports.styles as relative to the Markdown file."
        },
        "markdown-htmd-exports.includeDefaultStyles": {
          "type": "boolean",
          "default": true,
          "description": "Include VS Code's built-in Markdown base stylesheet alongside the active color theme variables, companion preview styles, and any custom markdown.styles."
        },
        "markdown-htmd-exports.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "Optional output directory for exported .htmd files."
        },
        "markdown-htmd-exports.outputDirectoryRelativePathFile": {
          "type": "boolean",
          "default": false,
          "description": "Interpret relative markdown-htmd-exports.outputDirectory paths as relative to the Markdown file."
        },
        "markdown-htmd-exports.sanitize": {
          "type": "string",
          "enum": [
            "gfm",
            "gfm-allow-style",
            "none"
          ],
          "default": "gfm",
          "description": "Sanitize raw HTML in Markdown per GitHub Flavored Markdown."
        },
        "markdown-htmd-exports.highlight": {
          "type": "boolean",
          "default": true,
          "description": "Enable syntax highlighting for fenced code blocks."
        },
        "markdown-htmd-exports.highlightStyle": {
          "type": "string",
          "default": "",
          "description": "Optional highlight.js stylesheet filename (defaults to VS Code's built-in highlight theme)."
        },
        "markdown-htmd-exports.breaks": {
          "type": "boolean",
          "default": false,
          "description": "Convert single newlines in paragraphs into <br> tags."
        },
        "markdown-htmd-exports.emoji": {
          "type": "boolean",
          "default": true,
          "description": "Enable native Unicode emoji shortcodes (e.g. :rocket: -> 🚀)."
        },
        "markdown-htmd-exports.mermaidServer": {
          "type": "string",
          "default": "https://unpkg.com/mermaid/dist/mermaid.min.js",
          "description": "Mermaid script URL (loaded only when the document contains a ```mermaid block)."
        },
        "markdown-htmd-exports.math.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable KaTeX math rendering for $...$, $$...$$, \\(...\\), \\[...\\], and ```math fenced blocks."
        },
        "markdown-htmd-exports.math.katex.macros": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "User-defined KaTeX macros passed to the KaTeX renderer."
        },
        "markdown-htmd-exports.StatusbarMessageTimeout": {
          "type": "number",
          "default": 5000,
          "description": "Status bar message timeout in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild source/extension.ts --bundle --outfile=build/extension.js --format=cjs --platform=node --external:vscode",
    "check": "tsc --noEmit",
    "watch": "npm run build -- --watch",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build.ps1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.5.2",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.45",
    "markdown-it": "^14.1.1",
    "markdown-it-emoji": "^3.0.0"
  }
}
